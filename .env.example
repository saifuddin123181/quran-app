# Settings the app needs. Copy to .env.local for local development (never commit .env.local),
# and add the same names in Vercel: Project > Settings > Environment Variables.

# Reader accounts: username:password pairs, comma-separated (a password can't contain a comma).
READER_ACCOUNTS=Reader1:change-me,Reader2:change-me-too

# Admin password for /admin (username "admin" or ID "admin-01").
ADMIN_PASSWORD=change-me

# Long random string that signs login cookies, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set automatically when a Vercel Blob store is connected to the project. With it in .env.local,
# local development uses that store too.
# BLOB_READ_WRITE_TOKEN=

# Where the page images are served from on Vercel; printed by scripts/upload-to-blob.mjs.
# NEXT_PUBLIC_MUSHAF_BASE_URL=
